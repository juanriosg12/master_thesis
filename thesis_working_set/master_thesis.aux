\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {$X \to X$ adjacency matrices for the synthetic linear-confounded dataset, where $\mathrm  {adj}[i,j]=1$ denotes an edge $i \to j$.} The True DAG (87 edges) is shown alongside the PC (54 edges) and LiNGAM (105 edges) recoveries. PC stays close to the sparse true structure, whereas LiNGAM scatters spurious edges across the matrix, the visual signature of the over-connection that drives its low precision.}}{23}{figure.caption.14}\protected@file@percent }
\newlabel{fig:adj_synthetic}{{3}{23}{\textbf {$X \to X$ adjacency matrices for the synthetic linear-confounded dataset, where $\mathrm {adj}[i,j]=1$ denotes an edge $i \to j$.} The True DAG (87 edges) is shown alongside the PC (54 edges) and LiNGAM (105 edges) recoveries. PC stays close to the sparse true structure, whereas LiNGAM scatters spurious edges across the matrix, the visual signature of the over-connection that drives its low precision}{figure.caption.14}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.1.2}Performance Reversal on the Sachs Cell Signaling Dataset}{23}{subsubsection.4.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {$X \to X$ adjacency matrices for the Sachs dataset, where $\mathrm  {adj}[i,j]=1$ denotes an edge $i \to j$.} The consensus reference DAG (17 edges) is compared against the PC (19 edges) and LiNGAM (26 edges) recoveries over the ten signaling proteins. Both algorithms recover only a fraction of the true links and introduce edges absent from the consensus network, with LiNGAM the denser of the two.}}{24}{figure.caption.15}\protected@file@percent }
\newlabel{fig:adj_sachs}{{4}{24}{\textbf {$X \to X$ adjacency matrices for the Sachs dataset, where $\mathrm {adj}[i,j]=1$ denotes an edge $i \to j$.} The consensus reference DAG (17 edges) is compared against the PC (19 edges) and LiNGAM (26 edges) recoveries over the ten signaling proteins. Both algorithms recover only a fraction of the true links and introduce edges absent from the consensus network, with LiNGAM the denser of the two}{figure.caption.15}{}}
