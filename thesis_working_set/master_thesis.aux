\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {Feature-level Magnitude Divergence $\Delta M_{\text  {oracle}}$ vs.\ the oracle DAG.}}}{37}{figure.caption.28}\protected@file@percent }
