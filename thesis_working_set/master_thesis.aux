\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.5.1}Correlated and Contested Discovery Failures}{40}{subsubsection.4.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \textbf  {Causal neighbourhood of X24 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} Blue edges are incoming (parents), amber edges are outgoing (children). In the True DAG, X24 is a direct parent of $Y$ with 3 incoming and 4 outgoing edges. Both PC and LiNGAM strip its true incoming edges and add spurious outgoing ones (6 out-edges under PC, 14 under LiNGAM, 0 in-edges in both), recasting a mid-graph node as an apparent root source.}}{40}{figure.caption.30}\protected@file@percent }
\newlabel{fig:dag_X24}{{13}{40}{\textbf {Causal neighbourhood of X24 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} Blue edges are incoming (parents), amber edges are outgoing (children). In the True DAG, X24 is a direct parent of $Y$ with 3 incoming and 4 outgoing edges. Both PC and LiNGAM strip its true incoming edges and add spurious outgoing ones (6 out-edges under PC, 14 under LiNGAM, 0 in-edges in both), recasting a mid-graph node as an apparent root source}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \textbf  {Shapley Flow SHAP scatter (feature value vs.\ SHAP value) for X24 under Traditional (no graph), Flow+PC, Flow+LiNGAM and Flow+True DAG, synthetic dataset.} The Traditional column shows a stable attribution pattern; both discovered-graph columns diverge substantially from the True-DAG oracle, with inflated and partially sign-flipped values. The magnitude of this divergence, 32.5\% of $\hat  {\sigma }$, is precisely the $\Delta M_{\text  {base}}$ signal identified in Section~\ref {sec:baseline}, making this scatter a direct visualisation of why large feature-level baseline divergence should trigger structural validation of the discovered graph.}}{41}{figure.caption.31}\protected@file@percent }
\newlabel{fig:shap_X24}{{14}{41}{\textbf {Shapley Flow SHAP scatter (feature value vs.\ SHAP value) for X24 under Traditional (no graph), Flow+PC, Flow+LiNGAM and Flow+True DAG, synthetic dataset.} The Traditional column shows a stable attribution pattern; both discovered-graph columns diverge substantially from the True-DAG oracle, with inflated and partially sign-flipped values. The magnitude of this divergence, 32.5\% of $\hat {\sigma }$, is precisely the $\Delta M_{\text {base}}$ signal identified in Section~\ref {sec:baseline}, making this scatter a direct visualisation of why large feature-level baseline divergence should trigger structural validation of the discovered graph}{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {Causal neighbourhood of X33 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} Neither PC nor LiNGAM recovers the true structure: the two algorithms disagree on both the parent set and the child set of X33, producing structurally divergent graphs that trigger both the $\Delta M_{\text  {base}}$ and $\Delta M_{\text  {disc}}$ alarm signals.}}{42}{figure.caption.32}\protected@file@percent }
\newlabel{fig:dag_X33}{{15}{42}{\textbf {Causal neighbourhood of X33 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} Neither PC nor LiNGAM recovers the true structure: the two algorithms disagree on both the parent set and the child set of X33, producing structurally divergent graphs that trigger both the $\Delta M_{\text {base}}$ and $\Delta M_{\text {disc}}$ alarm signals}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces \textbf  {Shapley Flow SHAP scatter for X33 under Traditional (no graph), Flow+PC, Flow+LiNGAM, and Flow+True DAG, synthetic dataset.} All three graph-aware columns produce distinct attribution distributions, none of which coincides with the oracle. This three-way divergence is the scatter-level signature of a node whose causal neighbourhood is both structurally influential and contested between the two discovery algorithms.}}{42}{figure.caption.33}\protected@file@percent }
\newlabel{fig:shap_X33}{{16}{42}{\textbf {Shapley Flow SHAP scatter for X33 under Traditional (no graph), Flow+PC, Flow+LiNGAM, and Flow+True DAG, synthetic dataset.} All three graph-aware columns produce distinct attribution distributions, none of which coincides with the oracle. This three-way divergence is the scatter-level signature of a node whose causal neighbourhood is both structurally influential and contested between the two discovery algorithms}{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces \textbf  {Causal neighbourhood of pka across the PC (left), True DAG (centre), and LiNGAM (right) graphs, Sachs dataset.} pka is a near-root source with 1 incoming and 6 outgoing edges in the consensus DAG. PC gives pka 3 incoming and 3 outgoing edges (reversing several true outgoing links), while LiNGAM keeps it a pure root with 7 outgoing edges and none incoming, much closer to the consensus structure. The PC reversal that adds spurious incoming edges drives its $\Delta M_{\text  {oracle}}$ from 6.4\% of $\hat  {\sigma }$ (LiNGAM) up to 25.0\% (PC).}}{43}{figure.caption.34}\protected@file@percent }
\newlabel{fig:dag_pka}{{17}{43}{\textbf {Causal neighbourhood of pka across the PC (left), True DAG (centre), and LiNGAM (right) graphs, Sachs dataset.} pka is a near-root source with 1 incoming and 6 outgoing edges in the consensus DAG. PC gives pka 3 incoming and 3 outgoing edges (reversing several true outgoing links), while LiNGAM keeps it a pure root with 7 outgoing edges and none incoming, much closer to the consensus structure. The PC reversal that adds spurious incoming edges drives its $\Delta M_{\text {oracle}}$ from 6.4\% of $\hat {\sigma }$ (LiNGAM) up to 25.0\% (PC)}{figure.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces \textbf  {Shapley Flow SHAP scatter for pka, Sachs dataset.} Flow+LiNGAM tracks Flow+True closely, while Flow+PC produces a visibly inflated attribution cluster, the scatter-level signature of PC's edge-reversal error that recasts pka as a high-in-degree intermediate node rather than the near-root source it is in the consensus DAG.}}{43}{figure.caption.35}\protected@file@percent }
\newlabel{fig:shap_pka}{{18}{43}{\textbf {Shapley Flow SHAP scatter for pka, Sachs dataset.} Flow+LiNGAM tracks Flow+True closely, while Flow+PC produces a visibly inflated attribution cluster, the scatter-level signature of PC's edge-reversal error that recasts pka as a high-in-degree intermediate node rather than the near-root source it is in the consensus DAG}{figure.caption.35}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.5.2}Directed Edge Inversion and Causal Credit Transfer}{43}{subsubsection.4.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces \textbf  {Causal neighbourhood of X47 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} In the True DAG, X47 is a mid-graph node with 3 incoming and 1 outgoing edge. PC recovers its incoming edges accurately; LiNGAM reverses them, leaving X47 as a 0-in/5-out apparent root source. This is the structural error that triggers both the $\Delta M_{\text  {base}}$ and $\Delta M_{\text  {disc}}$ alarms.}}{44}{figure.caption.36}\protected@file@percent }
\newlabel{fig:dag_X47}{{19}{44}{\textbf {Causal neighbourhood of X47 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} In the True DAG, X47 is a mid-graph node with 3 incoming and 1 outgoing edge. PC recovers its incoming edges accurately; LiNGAM reverses them, leaving X47 as a 0-in/5-out apparent root source. This is the structural error that triggers both the $\Delta M_{\text {base}}$ and $\Delta M_{\text {disc}}$ alarms}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces \textbf  {Causal neighbourhood of X21 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} In the True DAG and under PC, the edge runs $X_{21} \to X_{47}$. LiNGAM reverses it to $X_{47} \to X_{21}$, placing X47 upstream of X21 and misdirecting attribution credit in both Causal Shapley and Flow.}}{45}{figure.caption.37}\protected@file@percent }
\newlabel{fig:dag_X21}{{20}{45}{\textbf {Causal neighbourhood of X21 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} In the True DAG and under PC, the edge runs $X_{21} \to X_{47}$. LiNGAM reverses it to $X_{47} \to X_{21}$, placing X47 upstream of X21 and misdirecting attribution credit in both Causal Shapley and Flow}{figure.caption.37}{}}
\newlabel{fig:shap_X47_X21_causal}{{21a}{45}{Causal Shapley: under PC (correct orientation) both X21 and X47 attributions track the oracle. Under LiNGAM (reversed orientation), X47 is suppressed and X21 acquires inflated credit}{figure.caption.38}{}}
\newlabel{sub@fig:shap_X47_X21_causal}{{a}{45}{Causal Shapley: under PC (correct orientation) both X21 and X47 attributions track the oracle. Under LiNGAM (reversed orientation), X47 is suppressed and X21 acquires inflated credit}{figure.caption.38}{}}
\newlabel{fig:shap_X47_X21_flow}{{21b}{45}{Shapley Flow: the same orientation-driven credit transfer appears; Flow+PC and Flow+True agree closely, while Flow+LiNGAM diverges on both features}{figure.caption.38}{}}
\newlabel{sub@fig:shap_X47_X21_flow}{{b}{45}{Shapley Flow: the same orientation-driven credit transfer appears; Flow+PC and Flow+True agree closely, while Flow+LiNGAM diverges on both features}{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces \textbf  {SHAP scatter for X21 and X47 across graph configurations.}}}{45}{figure.caption.38}\protected@file@percent }
\newlabel{fig:shap_X47_X21}{{21}{45}{\textbf {SHAP scatter for X21 and X47 across graph configurations.}}{figure.caption.38}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.5.3}Structural Role Error Resolved by Domain Knowledge}{45}{subsubsection.4.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces \textbf  {Causal neighbourhood of erk across the PC (left), True DAG (centre), and LiNGAM (right) graphs, Sachs dataset.} In the consensus DAG erk is a downstream node receiving inputs from pka and mek. PC removes its incoming edges and leaves it as a boundary source; LiNGAM recovers at least some incoming connections, placing it closer to its true downstream role. This structural divergence between the two algorithms is what triggers both the $\Delta M_{\text  {base}}$ and $\Delta M_{\text  {disc}}$ alarms.}}{46}{figure.caption.39}\protected@file@percent }
\newlabel{fig:dag_erk}{{22}{46}{\textbf {Causal neighbourhood of erk across the PC (left), True DAG (centre), and LiNGAM (right) graphs, Sachs dataset.} In the consensus DAG erk is a downstream node receiving inputs from pka and mek. PC removes its incoming edges and leaves it as a boundary source; LiNGAM recovers at least some incoming connections, placing it closer to its true downstream role. This structural divergence between the two algorithms is what triggers both the $\Delta M_{\text {base}}$ and $\Delta M_{\text {disc}}$ alarms}{figure.caption.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces \textbf  {Shapley Flow SHAP scatter for erk, Sachs dataset.} Flow+PC produces a heavily inflated attribution cluster consistent with PC treating erk as an isolated root source. Flow+LiNGAM is less distorted and sits closer to the oracle distribution, reflecting LiNGAM's partial recovery of erk's incoming edges. The gap between the two discovered-graph columns is the scatter-level signature of the $\Delta M_{\text  {disc}}$ alarm, and the oracle column confirms that LiNGAM's graph is the more trustworthy input for this protein.}}{47}{figure.caption.40}\protected@file@percent }
\newlabel{fig:shap_erk}{{23}{47}{\textbf {Shapley Flow SHAP scatter for erk, Sachs dataset.} Flow+PC produces a heavily inflated attribution cluster consistent with PC treating erk as an isolated root source. Flow+LiNGAM is less distorted and sits closer to the oracle distribution, reflecting LiNGAM's partial recovery of erk's incoming edges. The gap between the two discovered-graph columns is the scatter-level signature of the $\Delta M_{\text {disc}}$ alarm, and the oracle column confirms that LiNGAM's graph is the more trustworthy input for this protein}{figure.caption.40}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.5.4}Near-Zero Attributions and Sign Disagreement Explosion}{47}{subsubsection.4.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces \textbf  {Causal neighbourhood of X10 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} X10's neighbourhood is reconstructed differently by PC relative to the True DAG, introducing structural changes that shift its interventional conditioning set. Because X10's Traditional Shapley values sit near zero, even small attribution shifts are sufficient to flip sign on nearly all instances.}}{48}{figure.caption.41}\protected@file@percent }
\newlabel{fig:dag_X10}{{24}{48}{\textbf {Causal neighbourhood of X10 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} X10's neighbourhood is reconstructed differently by PC relative to the True DAG, introducing structural changes that shift its interventional conditioning set. Because X10's Traditional Shapley values sit near zero, even small attribution shifts are sufficient to flip sign on nearly all instances}{figure.caption.41}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces \textbf  {Traditional vs.\ Causal+PC SHAP scatter for X10, synthetic dataset.} The Traditional column shows attributions clustered near zero; the Causal+PC column disperses them to both sides of zero with larger magnitude. This scatter-level divergence, producing $D_{\text  {base}} = 96\%$, is the direct consequence of near-zero baseline attributions being pushed across the sign boundary by graph-induced interventional redistribution.}}{48}{figure.caption.42}\protected@file@percent }
\newlabel{fig:shap_X10}{{25}{48}{\textbf {Traditional vs.\ Causal+PC SHAP scatter for X10, synthetic dataset.} The Traditional column shows attributions clustered near zero; the Causal+PC column disperses them to both sides of zero with larger magnitude. This scatter-level divergence, producing $D_{\text {base}} = 96\%$, is the direct consequence of near-zero baseline attributions being pushed across the sign boundary by graph-induced interventional redistribution}{figure.caption.42}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {26}{\ignorespaces \textbf  {Causal neighbourhood of pkc across the PC (left), True DAG (centre), and LiNGAM (right) graphs, Sachs dataset.} PC and LiNGAM discover different parent and child sets for pkc, generating different interventional conditioning environments. Because pkc's Traditional Shapley values sit near zero, these structural differences are sufficient to produce high sign disagreement without producing large magnitude divergence.}}{49}{figure.caption.43}\protected@file@percent }
\newlabel{fig:dag_pkc}{{26}{49}{\textbf {Causal neighbourhood of pkc across the PC (left), True DAG (centre), and LiNGAM (right) graphs, Sachs dataset.} PC and LiNGAM discover different parent and child sets for pkc, generating different interventional conditioning environments. Because pkc's Traditional Shapley values sit near zero, these structural differences are sufficient to produce high sign disagreement without producing large magnitude divergence}{figure.caption.43}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {27}{\ignorespaces \textbf  {Traditional vs.\ Causal+LiNGAM SHAP scatter for pkc, Sachs dataset.} The Traditional column concentrates near zero; Causal+LiNGAM disperses attributions to both sides of zero. The magnitude of the shift is small relative to $\hat  {\sigma }$, which is why pkc does not appear in the magnitude heatmaps, but it is large enough to cross the sign boundary for a high fraction of instances, which is precisely why it leads the sign heatmaps instead.}}{49}{figure.caption.44}\protected@file@percent }
\newlabel{fig:shap_pkc}{{27}{49}{\textbf {Traditional vs.\ Causal+LiNGAM SHAP scatter for pkc, Sachs dataset.} The Traditional column concentrates near zero; Causal+LiNGAM disperses attributions to both sides of zero. The magnitude of the shift is small relative to $\hat {\sigma }$, which is why pkc does not appear in the magnitude heatmaps, but it is large enough to cross the sign boundary for a high fraction of instances, which is precisely why it leads the sign heatmaps instead}{figure.caption.44}{}}
