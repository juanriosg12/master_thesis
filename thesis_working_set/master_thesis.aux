\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.5.1}Out-Degree Inflation and Root Cause Overloading}{36}{subsubsection.4.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \textbf  {Causal neighbourhood of X24 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} Blue edges are incoming (parents), amber edges are outgoing (children). In the True DAG, X24 is a direct parent of $Y$ with 3 incoming and 4 outgoing edges. Both PC and LiNGAM strip its true incoming edges and add spurious outgoing ones (6 out-edges under PC, 14 under LiNGAM, 0 in-edges in both), recasting a mid-graph node as an apparent root source.}}{37}{figure.caption.30}\protected@file@percent }
\newlabel{fig:dag_X24}{{14}{37}{\textbf {Causal neighbourhood of X24 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} Blue edges are incoming (parents), amber edges are outgoing (children). In the True DAG, X24 is a direct parent of $Y$ with 3 incoming and 4 outgoing edges. Both PC and LiNGAM strip its true incoming edges and add spurious outgoing ones (6 out-edges under PC, 14 under LiNGAM, 0 in-edges in both), recasting a mid-graph node as an apparent root source}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {Shapley Flow SHAP scatter (feature value vs.\ SHAP value) for X24 under Traditional (no graph), Flow+PC, Flow+LiNGAM and Flow+True DAG, synthetic dataset.} The Traditional column shows a stable attribution pattern; both discovered-graph columns diverge substantially from the True-DAG oracle, with inflated and partially sign-flipped values. The magnitude of this divergence, 32.5\% of $\hat  {\sigma }$, is precisely the $\Delta M_{\text  {base}}$ signal identified in Section~\ref {sec:baseline}, making this scatter a direct visualisation of why large feature-level baseline divergence should trigger structural validation of the discovered graph.}}{38}{figure.caption.31}\protected@file@percent }
\newlabel{fig:shap_X24}{{15}{38}{\textbf {Shapley Flow SHAP scatter (feature value vs.\ SHAP value) for X24 under Traditional (no graph), Flow+PC, Flow+LiNGAM and Flow+True DAG, synthetic dataset.} The Traditional column shows a stable attribution pattern; both discovered-graph columns diverge substantially from the True-DAG oracle, with inflated and partially sign-flipped values. The magnitude of this divergence, 32.5\% of $\hat {\sigma }$, is precisely the $\Delta M_{\text {base}}$ signal identified in Section~\ref {sec:baseline}, making this scatter a direct visualisation of why large feature-level baseline divergence should trigger structural validation of the discovered graph}{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces \textbf  {Causal neighbourhood of X47 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} PC recovers X47's incoming edges accurately (depth 2, 3 in-edges), whereas LiNGAM reverses them, leaving X47 as a 0-in / 5-out apparent source.}}{38}{figure.caption.32}\protected@file@percent }
\newlabel{fig:dag_X47}{{16}{38}{\textbf {Causal neighbourhood of X47 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} PC recovers X47's incoming edges accurately (depth 2, 3 in-edges), whereas LiNGAM reverses them, leaving X47 as a 0-in / 5-out apparent source}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces \textbf  {Shapley Flow SHAP scatter for X47.} Flow+PC and Flow+True columns show closely matching magnitudes, while Flow+LiNGAM is visibly inflated---the scatter-level signature of reversal-induced root-source overloading.}}{39}{figure.caption.33}\protected@file@percent }
\newlabel{fig:shap_X47}{{17}{39}{\textbf {Shapley Flow SHAP scatter for X47.} Flow+PC and Flow+True columns show closely matching magnitudes, while Flow+LiNGAM is visibly inflated---the scatter-level signature of reversal-induced root-source overloading}{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces \textbf  {Causal neighbourhood of pka across the PC (left), True DAG (centre), and LiNGAM (right) graphs, Sachs dataset.} pka is a near-root source with 1 incoming and 6 outgoing edges in the consensus DAG. PC gives pka 3 incoming and 3 outgoing edges (reversing several true outgoing links), while LiNGAM keeps it a pure root with 7 outgoing edges and none incoming, much closer to the consensus structure. The PC reversal that adds spurious incoming edges drives its $\Delta M_{\text  {oracle}}$ from 6.4\% of $\hat  {\sigma }$ (LiNGAM) up to 25.0\% (PC).}}{40}{figure.caption.34}\protected@file@percent }
\newlabel{fig:dag_pka}{{18}{40}{\textbf {Causal neighbourhood of pka across the PC (left), True DAG (centre), and LiNGAM (right) graphs, Sachs dataset.} pka is a near-root source with 1 incoming and 6 outgoing edges in the consensus DAG. PC gives pka 3 incoming and 3 outgoing edges (reversing several true outgoing links), while LiNGAM keeps it a pure root with 7 outgoing edges and none incoming, much closer to the consensus structure. The PC reversal that adds spurious incoming edges drives its $\Delta M_{\text {oracle}}$ from 6.4\% of $\hat {\sigma }$ (LiNGAM) up to 25.0\% (PC)}{figure.caption.34}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.5.2}Directed Edge Inversion and Causal Credit Transfer}{40}{subsubsection.4.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces \textbf  {Causal neighbourhood of X21 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} In the True DAG and under LiNGAM, the edge runs $X_{21} \to X_{47}$. PC reverses it to $X_{47} \to X_{21}$, placing X47 upstream of X21 and misdirecting attribution credit in both Causal Shapley and Flow.}}{41}{figure.caption.35}\protected@file@percent }
\newlabel{fig:dag_X21}{{19}{41}{\textbf {Causal neighbourhood of X21 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} In the True DAG and under LiNGAM, the edge runs $X_{21} \to X_{47}$. PC reverses it to $X_{47} \to X_{21}$, placing X47 upstream of X21 and misdirecting attribution credit in both Causal Shapley and Flow}{figure.caption.35}{}}
\newlabel{fig:shap_X47_X21_causal}{{20a}{41}{Causal Shapley: under LiNGAM (correct orientation) both X21 and X47 attributions track the oracle. Under PC (reversed orientation), X47 is suppressed and X21 acquires inflated credit}{figure.caption.36}{}}
\newlabel{sub@fig:shap_X47_X21_causal}{{a}{41}{Causal Shapley: under LiNGAM (correct orientation) both X21 and X47 attributions track the oracle. Under PC (reversed orientation), X47 is suppressed and X21 acquires inflated credit}{figure.caption.36}{}}
\newlabel{fig:shap_X47_X21_flow}{{20b}{41}{Shapley Flow: the same orientation-driven credit transfer appears; Flow+LiNGAM and Flow+True agree closely, while Flow+PC diverges on both features}{figure.caption.36}{}}
\newlabel{sub@fig:shap_X47_X21_flow}{{b}{41}{Shapley Flow: the same orientation-driven credit transfer appears; Flow+LiNGAM and Flow+True agree closely, while Flow+PC diverges on both features}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces \textbf  {SHAP scatter for X21 and X47 across graph configurations.}}}{41}{figure.caption.36}\protected@file@percent }
\newlabel{fig:shap_X47_X21}{{20}{41}{\textbf {SHAP scatter for X21 and X47 across graph configurations.}}{figure.caption.36}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.5.3}Confounded Subordination and Boundary Isolation}{41}{subsubsection.4.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces \textbf  {Causal neighbourhood of X6 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} X6 is a genuine intermediate node with 3 incoming and 4 outgoing edges in the True DAG. LiNGAM inflates its in-degree to 8, the over-connection that contaminates its interventional parent set under Causal Shapley.}}{42}{figure.caption.37}\protected@file@percent }
\newlabel{fig:dag_X6}{{21}{42}{\textbf {Causal neighbourhood of X6 across the PC (left), True DAG (centre), and LiNGAM (right) graphs, synthetic dataset.} X6 is a genuine intermediate node with 3 incoming and 4 outgoing edges in the True DAG. LiNGAM inflates its in-degree to 8, the over-connection that contaminates its interventional parent set under Causal Shapley}{figure.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces \textbf  {Causal Shapley SHAP scatter for X6 across Traditional (no graph), Causal+PC, Causal+LiNGAM and Causal+True DAG, synthetic dataset.} The LiNGAM column diverges substantially from both the Traditional baseline and the True DAG oracle, while PC stays close to the oracle---a direct consequence of LiNGAM inflating X6's in-degree from 3 to 8 and contaminating its interventional conditioning set.}}{42}{figure.caption.38}\protected@file@percent }
\newlabel{fig:shap_X6}{{22}{42}{\textbf {Causal Shapley SHAP scatter for X6 across Traditional (no graph), Causal+PC, Causal+LiNGAM and Causal+True DAG, synthetic dataset.} The LiNGAM column diverges substantially from both the Traditional baseline and the True DAG oracle, while PC stays close to the oracle---a direct consequence of LiNGAM inflating X6's in-degree from 3 to 8 and contaminating its interventional conditioning set}{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces \textbf  {Causal neighbourhood of erk across the PC (left), True DAG (centre), and LiNGAM (right) graphs, Sachs dataset.} In the consensus DAG erk is a downstream node receiving inputs from pka and mek. PC removes its true incoming edges and leaves it with outgoing edges only, recasting a downstream node as a boundary source, the mis-orientation that drives Flow+PC's feature-level $\Delta M_{\text  {oracle}}$ of 49.2\% of $\hat  {\sigma }$.}}{43}{figure.caption.39}\protected@file@percent }
\newlabel{fig:dag_erk}{{23}{43}{\textbf {Causal neighbourhood of erk across the PC (left), True DAG (centre), and LiNGAM (right) graphs, Sachs dataset.} In the consensus DAG erk is a downstream node receiving inputs from pka and mek. PC removes its true incoming edges and leaves it with outgoing edges only, recasting a downstream node as a boundary source, the mis-orientation that drives Flow+PC's feature-level $\Delta M_{\text {oracle}}$ of 49.2\% of $\hat {\sigma }$}{figure.caption.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces \textbf  {Shapley Flow SHAP scatter for erk, Sachs dataset.} All three graph-aware variants diverge from each other and from the Traditional baseline. Flow+PC inflates erk's attributions by treating it as a source node; Flow+LiNGAM produces a distinct distortion; only Flow+True DAG tracks the correct downstream credit distribution. The simultaneous divergence on $\Delta M_{\text  {base}}$, $\Delta M_{\text  {oracle}}$, and $\Delta M_{\text  {disc}}$ marks erk as a node where structure-aware methods should not be deployed without prior graph validation.}}{43}{figure.caption.40}\protected@file@percent }
\newlabel{fig:shap_erk}{{24}{43}{\textbf {Shapley Flow SHAP scatter for erk, Sachs dataset.} All three graph-aware variants diverge from each other and from the Traditional baseline. Flow+PC inflates erk's attributions by treating it as a source node; Flow+LiNGAM produces a distinct distortion; only Flow+True DAG tracks the correct downstream credit distribution. The simultaneous divergence on $\Delta M_{\text {base}}$, $\Delta M_{\text {oracle}}$, and $\Delta M_{\text {disc}}$ marks erk as a node where structure-aware methods should not be deployed without prior graph validation}{figure.caption.40}{}}
