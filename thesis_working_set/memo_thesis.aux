\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.5.1}Out-Degree Inflation and Root Cause Overloading}{7}{subsubsection.4.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Causal neighbourhood of X24 (Synthetic).} Both PC and LiNGAM strip true parents and add spurious children (6 and 14 out-edges respectively, 0 in-edges), converting a mid-graph node into an apparent root source. Blue = incoming, amber = outgoing.}}{8}{figure.caption.18}\protected@file@percent }
\newlabel{fig:dag_X24}{{6}{8}{\textbf {Causal neighbourhood of X24 (Synthetic).} Both PC and LiNGAM strip true parents and add spurious children (6 and 14 out-edges respectively, 0 in-edges), converting a mid-graph node into an apparent root source. Blue = incoming, amber = outgoing}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Shapley Flow SHAP scatter for X24 (Synthetic).} Traditional shows a stable attribution pattern; both discovered-graph columns diverge substantially from the True-DAG oracle---the instance-level signature of out-degree inflation ($\Delta M_{\text  {base}} = 32.5\%$ of $\hat  {\sigma }$).}}{8}{figure.caption.19}\protected@file@percent }
\newlabel{fig:shap_X24}{{7}{8}{\textbf {Shapley Flow SHAP scatter for X24 (Synthetic).} Traditional shows a stable attribution pattern; both discovered-graph columns diverge substantially from the True-DAG oracle---the instance-level signature of out-degree inflation ($\Delta M_{\text {base}} = 32.5\%$ of $\hat {\sigma }$)}{figure.caption.19}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.5.2}Directed Edge Inversion and Causal Credit Transfer}{8}{subsubsection.4.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Causal neighbourhood of pka (Sachs).} PC gives pka 3 incoming and 3 outgoing edges, reversing several true outgoing links. LiNGAM keeps it a near-root with 7 outgoing and 0 incoming edges, much closer to the consensus structure.}}{8}{figure.caption.20}\protected@file@percent }
\newlabel{fig:dag_pka}{{8}{8}{\textbf {Causal neighbourhood of pka (Sachs).} PC gives pka 3 incoming and 3 outgoing edges, reversing several true outgoing links. LiNGAM keeps it a near-root with 7 outgoing and 0 incoming edges, much closer to the consensus structure}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Causal neighbourhood of X21 (Synthetic).} In the True DAG and under PC the edge runs $X_{21} \to X_{47}$. LiNGAM reverses it to $X_{47} \to X_{21}$, misdirecting attribution credit in both CSV and Flow.}}{8}{figure.caption.21}\protected@file@percent }
\newlabel{fig:dag_X21}{{9}{8}{\textbf {Causal neighbourhood of X21 (Synthetic).} In the True DAG and under PC the edge runs $X_{21} \to X_{47}$. LiNGAM reverses it to $X_{47} \to X_{21}$, misdirecting attribution credit in both CSV and Flow}{figure.caption.21}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.5.3}Node Misspecification Captured by Experimental Metrics}{8}{subsubsection.4.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {SHAP scatter for X21 and X47 (Synthetic).} \textit  {Top} (Causal Shapley): under PC both features track the oracle; under LiNGAM, X47 is suppressed and X21 acquires inflated credit. \textit  {Bottom} (Shapley Flow): the same orientation-driven credit transfer appears; Flow+PC and Flow+True agree closely while Flow+LiNGAM diverges on both features.}}{9}{figure.caption.22}\protected@file@percent }
\newlabel{fig:shap_X47_X21}{{10}{9}{\textbf {SHAP scatter for X21 and X47 (Synthetic).} \textit {Top} (Causal Shapley): under PC both features track the oracle; under LiNGAM, X47 is suppressed and X21 acquires inflated credit. \textit {Bottom} (Shapley Flow): the same orientation-driven credit transfer appears; Flow+PC and Flow+True agree closely while Flow+LiNGAM diverges on both features}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {Causal neighbourhood of erk (Sachs).} PC removes its true parent links (pka, mek) and isolates erk as a boundary source---driving Flow+PC's $\Delta M_{\text  {oracle}} = 49.2\%$ of $\hat  {\sigma }$.}}{9}{figure.caption.23}\protected@file@percent }
\newlabel{fig:dag_erk}{{11}{9}{\textbf {Causal neighbourhood of erk (Sachs).} PC removes its true parent links (pka, mek) and isolates erk as a boundary source---driving Flow+PC's $\Delta M_{\text {oracle}} = 49.2\%$ of $\hat {\sigma }$}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {Shapley Flow SHAP scatter for erk (Sachs).} All three graph-aware variants diverge from each other and from Traditional. Flow+PC inflates erk's attributions by treating it as an isolated source node; only Flow+True DAG tracks the correct downstream credit distribution.}}{10}{figure.caption.24}\protected@file@percent }
\newlabel{fig:shap_erk}{{12}{10}{\textbf {Shapley Flow SHAP scatter for erk (Sachs).} All three graph-aware variants diverge from each other and from Traditional. Flow+PC inflates erk's attributions by treating it as an isolated source node; only Flow+True DAG tracks the correct downstream credit distribution}{figure.caption.24}{}}
