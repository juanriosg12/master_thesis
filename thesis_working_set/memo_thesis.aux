\newlabel{fig:dag_X24}{{5}{8}{\textbf {Causal neighbourhood of X24 (Synthetic).} Both PC and LiNGAM strip true parents and add spurious children (6 and 14 out-edges respectively, 0 in-edges), converting a mid-graph node into an apparent root source. Blue = incoming, amber = outgoing}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Shapley Flow SHAP scatter for X24 (Synthetic).} Traditional shows a stable attribution pattern; both discovered-graph columns diverge substantially from the True-DAG oracle---the instance-level signature of out-degree inflation ($\Delta M_{\text  {base}} = 32.5\%$ of $\hat  {\sigma }$).}}{8}{figure.caption.19}\protected@file@percent }
\newlabel{fig:shap_X24}{{6}{8}{\textbf {Shapley Flow SHAP scatter for X24 (Synthetic).} Traditional shows a stable attribution pattern; both discovered-graph columns diverge substantially from the True-DAG oracle---the instance-level signature of out-degree inflation ($\Delta M_{\text {base}} = 32.5\%$ of $\hat {\sigma }$)}{figure.caption.19}{}}
